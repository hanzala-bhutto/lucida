{
  "name": "lucida",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "A whiteboard for Windows: write a word and get a picture, one board per folder, a plan wall synced with Markdown files, and an MCP server so agents can draw on it. Tauri + React + Excalidraw.",
  "license": "MIT",
  "author": "Julian Lang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lang-Julian/lucida.git"
  },
  "homepage": "https://github.com/Lang-Julian/lucida#readme",
  "bugs": {
    "url": "https://github.com/Lang-Julian/lucida/issues"
  },
  "keywords": [
    "tauri",
    "react",
    "excalidraw",
    "llama.cpp",
    "whiteboard",
    "local-first",
    "on-device-ai",
    "diagramming",
    "windows"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsx scratch/test-recognizer.ts && tsx scratch/test-ai.ts && tsx scratch/test-project.ts && tsx scratch/test-masterplan.ts && tsx scratch/test-company-map.ts && tsx scratch/test-plan.ts && node scratch/test-mcp.mjs",
    "tauri": "tauri",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
